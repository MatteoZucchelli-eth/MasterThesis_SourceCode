  Height: 845
  Hide Left Dock: false
  Hide Right Dock: true
  Image:
    collapsed: false
  PerceptionOverlay:
    collapsed: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 924
  X: 0
  Y: 32
