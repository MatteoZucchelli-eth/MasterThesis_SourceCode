<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_common</name>
  <version>0.0.0</version>
  <description>Common toolbox to run the G1</description>
  <maintainer email="brandesa@ethz.ch">MRL</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>unitree_hg</depend>
  <!-- g1_common.camera: pinhole geometry and undistort/crop remap. -->
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <!-- g1_common.image_transport: raw/compressed images and JPEG decode. -->
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
