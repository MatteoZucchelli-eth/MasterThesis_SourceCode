<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_control</name>
  <version>0.0.0</version>
  <description>RL policy controller for Unitree G1 humanoid</description>
  <maintainer email="ahansson@ethz.ch">Alexander Hansson</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>unitree_hg</depend>
  <depend>g1_definitions</depend>
  <depend>g1_common</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>g1_interfaces</depend>
  <depend>g1_teleoperation</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <!-- pupil-apriltags is pip-installed from the repository requirements; it
       has no rosdep key. scipy is used for the SO(3) sample mean. -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
