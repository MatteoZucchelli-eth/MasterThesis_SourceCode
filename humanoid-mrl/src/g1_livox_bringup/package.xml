<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_livox_bringup</name>
  <version>0.0.0</version>
  <description>Bringup scripts for the livox lidar on the unitree G1</description>
  <maintainer email="joshua.naef@mrl.ethz.ch">MRL</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <depend>livox_ros_driver2</depend>
  <depend>livox_sdk2</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
