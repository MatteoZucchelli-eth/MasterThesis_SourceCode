<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_state_machine</name>
  <version>0.0.0</version>
  <description>Implements state machine logic for switching between operating states</description>
  <maintainer email="brandesa@ethz.ch">MRL</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>g1_common</depend>
  <depend>g1_definitions</depend>
  <depend>g1_sensors</depend>
  <depend>unitree_hg</depend>

  <exec_depend>g1_control</exec_depend>
  <exec_depend>g1_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>qualisys_driver</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
