<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_sensors</name>
  <version>0.0.0</version>
  <description>Simple sensor publishers for testing and development</description>
  <maintainer email="mrl@example.com">MRL</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>ament_index_python</depend>
  <depend>geometry_msgs</depend>
  <depend>mocap4r2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>g1_common</depend>
  <depend>g1_interfaces</depend>

  <exec_depend>python3-opencv</exec_depend>
  <!-- head_camera_calibration only. pupil_apriltags is pip-installed (no rosdep key). -->
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <depend>g1_definitions</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
