ARG ARCH=aarch64

# ARM base
FROM dustynv/ros:jazzy-desktop-r36.4.0-cu128-24.04 AS aarch64

SHELL ["/bin/bash", "-o", "pipefail", "-ic"]
ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,id=nvblox_apt_cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=nvblox_apt_cache,target=/var/lib/apt,sharing=locked \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(source /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list >/dev/null \
    && apt-get update

ENV TZ=Europe/Berlin
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ >/etc/timezone
# hadolint ignore=DL3008
RUN --mount=type=cache,id=nvblox_apt_cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=nvblox_apt_cache,target=/var/lib/apt,sharing=locked \
    apt-get install -y --no-install-recommends tzdata

# ROS is built from source in this base image.
RUN echo "source /opt/ros/jazzy/install/setup.bash" >>/etc/bash.bashrc

RUN /ros2_install.sh realsense2_camera

COPY --chmod=755 docker/ros_entrypoint.sh /ros_entrypoint.sh

# Final image
ARG ARCH
FROM ${ARCH} AS final

SHELL ["/bin/bash", "-o", "pipefail", "-ic"]

RUN --mount=type=cache,id=nvblox_apt_cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=nvblox_apt_cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    gnupg=2.4.* \
    apt-utils=2.8.* \
    software-properties-common=0.99.49.* \
    build-essential=12.10ubuntu1 \
    python3-pip=24.0+dfsg-1ubuntu1.3 \
    python3-venv=3.12.* \
    libgoogle-glog-dev=0.6.* \
    libgtest-dev=1.14.* \
    libbenchmark-dev=1.8.* \
    libsqlite3-dev=3.45.* \
    python3-colcon-common-extensions=0.3.* \
    python3-rosdep=0.26.* \
    && rm -rf /var/lib/apt/lists/*

# hadolint ignore=SC2016
RUN printf '%s\n' 'PATH=$PATH:/usr/local/cuda/bin' \
        'export CUDA_PATH=/usr/local/cuda' >/etc/nvblox_env.sh \
    && echo 'source /etc/nvblox_env.sh' >>/etc/bash.bashrc

RUN rosdep init 2>/dev/null || true \
    && rosdep update

COPY src/nvblox_ros2 /root/workspace/src/nvblox_ros2

WORKDIR /root/workspace
# Use a distinct cache from the core image.
RUN --mount=type=cache,id=nvblox_colcon_cache,target=/root/workspace/build source /etc/nvblox_env.sh && colcon build

RUN echo 'source /root/workspace/install/setup.bash' | tee --append /etc/nvblox_env.sh
