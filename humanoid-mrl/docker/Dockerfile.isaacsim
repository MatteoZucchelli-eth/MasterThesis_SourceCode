# Builder stage based on IsaacSim-ros_workspaces tag 5.1.0
# This stage builds the ros workspace with a isaac sim compatible version of python (i.e. 3.11)
# source: https://github.com/isaac-sim/IsaacSim-ros_workspaces/blob/50de00358f220d790d17050c6368cfe9a9cb9f51/dockerfiles/ubuntu_24_jazzy_python_311_minimal.dockerfile
FROM ubuntu:24.04@sha256:186072bba1b2f436cbb91ef2567abca677337cfc786c86e107d25b7072feef0c AS builder

ENV ROS_DISTRO=jazzy
ENV ROS_ROOT=jazzy_ws
ENV ROS_PYTHON_VERSION=3

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential=12.10* \
        cmake=3.28.3* \
        git=1:2.43.0* \
        curl=8.5.0* \
        wget=1.21.* \
        gnupg2=2.4.* \
        lsb-release=12.0* \
        software-properties-common=0.99.49* \
        locales=2.39* \
    && rm -rf /var/lib/apt/lists/*

RUN locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && export LANG=en_US.UTF-8

RUN apt-get update \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get install --no-install-recommends -y \
        python3.11=3.11* \
        python3.11-dev=3.11* \
        python3.11-distutils=3.11* \
        python3.11-venv=3.11* \
    && rm -rf /var/lib/apt/lists/*

# Set default Python3 to Python3.11
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Pip install stuff
RUN curl -s https://bootstrap.pypa.io/get-pip.py -o get-pip.py \
    && python3.11 get-pip.py --force-reinstall \
    && rm get-pip.py

RUN curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc -o ros.asc && apt-key add ros.asc
RUN sh -c 'echo "deb [arch=$(dpkg --print-architecture)] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" > /etc/apt/sources.list.d/ros2-latest.list'

# ROS build dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config=1.8* \
    python3-yaml=6.0* \
    cmake-extras=1.7* \
    libboost-all-dev \
    libfmt-dev \
    libqhull-dev \
    libassimp-dev \
    liboctomap-dev \
    libconsole-bridge-dev \
    libfcl-dev \
    libeigen3-dev \
    libx11-dev \
    libxaw7-dev \
    libxrandr-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libglew-dev \
    libgles2-mesa-dev \
    libopengl-dev \
    libfreetype-dev \
    libfontconfig1-dev \
    qtbase5-dev \
    qtchooser \
    qt5-qmake \
    qtbase5-dev-tools \
    libqt5core5a \
    libqt5gui5 \
    libqt5opengl5 \
    libqt5widgets5 \
    libxcursor-dev \
    libxinerama-dev \
    libxi-dev \
    libyaml-cpp-dev \
    libassimp-dev \
    libzzip-dev \
    freeglut3-dev \
    libogre-1.9-dev \
    libpng-dev \
    libjpeg-dev \
    python3-pyqt5.qtwebengine \
    python3-pip \
    python3-pytest-cov \
    python3-rosinstall-generator \
    ros-dev-tools \
    libbullet-dev \
    libasio-dev \
    libtinyxml2-dev \
    libcunit1-dev \
    libacl1-dev \
    python3-empy \
    libpython3-dev \
    liblttng-ust-dev \
    && rm -rf /var/lib/apt/lists/*

# ROS 2 Jazzy requires empy 3.3.4.
RUN pip3 install setuptools==70.0.0 \
    && (python3.11 -m pip uninstall -y em empy || true) \
    && python3.11 -m pip install empy==3.3.4

# hadolint ignore=DL3013
RUN python3 -m pip install -U --ignore-installed \
    argcomplete \
    flake8-blind-except \
    flake8-builtins \
    flake8-class-newline \
    flake8-comprehensions \
    flake8-deprecated \
    flake8-docstrings \
    flake8-import-order \
    flake8-quotes \
    pytest-repeat \
    pytest-rerunfailures \
    pytest \
    lark

# hadolint ignore=DL3013
RUN python3.11 -m pip uninstall numpy -y \
    && python3.11 -m pip install --ignore-installed --upgrade pip \
    && python3.11 -m pip install --ignore-installed numpy PyYAML "pybind11[global]" \
    && ln -sf /usr/include/python3.11 /usr/include/python3

WORKDIR ${ROS_ROOT}
RUN mkdir -p src \
    && rosinstall_generator --deps --rosdistro ${ROS_DISTRO} rosidl_runtime_c rosidl_generator_dds_idl rcutils rcl rmw tf2 tf2_msgs common_interfaces geometry_msgs nav_msgs std_msgs rosgraph_msgs sensor_msgs vision_msgs rclpy ros2topic ros2pkg ros2doctor ros2run ros2node ros_environment example_interfaces >ros2.${ROS_DISTRO}.rosinstall \
    && cat ros2.${ROS_DISTRO}.rosinstall \
    && vcs import src <ros2.${ROS_DISTRO}.rosinstall

# Patch rclpy for Python 3.11.
# hadolint ignore=DL4006,SC2016
RUN find /workspace/${ROS_ROOT}/src -name rclpy -type d | xargs -I{} /bin/bash -c 'if [ -f {}/CMakeLists.txt ]; then \
    echo "Patching {}/CMakeLists.txt"; \
    sed -i "s/include_directories(\${PYTHON_INCLUDE_DIRS})/include_directories(\/usr\/include\/python3.11)/" {}/CMakeLists.txt; \
    sed -i "s/\${PYTHON_LIBRARY}/python3.11/" {}/CMakeLists.txt; \
    fi'

WORKDIR /workspace
RUN rosdep init && rosdep update

ENV PYTHONPATH=/usr/local/lib/python3.11/dist-packages

WORKDIR ${ROS_ROOT}
RUN colcon build --cmake-args \
    "-DPython3_EXECUTABLE=/usr/bin/python3.11" \
    "-DPYTHON_EXECUTABLE=/usr/bin/python3.11" \
    "-DPYTHON_INCLUDE_DIR=/usr/include/python3.11" \
    "-DPYTHON_LIBRARY=/usr/lib/x86_64-linux-gnu/libpython3.11.so" \
    --merge-install

# Compatibility libraries may not exist on every base image.
RUN cp /usr/lib/x86_64-linux-gnu/libtinyxml2.so* /workspace/jazzy_ws/install/lib/ 2>/dev/null || true; \
    cp /usr/lib/x86_64-linux-gnu/libssl.so* /workspace/jazzy_ws/install/lib/ 2>/dev/null || true; \
    cp /usr/lib/x86_64-linux-gnu/libcrypto.so* /workspace/jazzy_ws/install/lib/ 2>/dev/null || true

RUN mkdir -p /workspace/build_ws/src

COPY src /workspace/build_ws/src

# qualisys_driver is only needed by real-robot launches.
RUN sed -i '/<exec_depend>qualisys_driver<\/exec_depend>/d' /workspace/build_ws/src/g1_state_machine/package.xml

WORKDIR /workspace

ENV PYTHON_EXECUTABLE=/usr/bin/python3.11 \
    Python3_EXECUTABLE=/usr/bin/python3.11 \
    PYTHON_INCLUDE_DIR=/usr/include/python3.11 \
    PYTHON_LIBRARY=/usr/lib/x86_64-linux-gnu/libpython3.11.so

ENV COLCON_PACKAGES_UP_TO="unitree_api unitree_hg g1_definitions g1_simulation g1_state_machine g1_common"

ENV COLCON_PACKAGES_IGNORE="qualisys_driver"

RUN /bin/bash -c "source ${ROS_ROOT}/install/setup.sh && cd build_ws && colcon build \
    --packages-up-to ${COLCON_PACKAGES_UP_TO} \
    --packages-ignore ${COLCON_PACKAGES_IGNORE} \
    --cmake-args \
    '-DPython3_EXECUTABLE=/usr/bin/python3.11' \
    '-DPYTHON_EXECUTABLE=/usr/bin/python3.11' \
    '-DPYTHON_INCLUDE_DIR=/usr/include/python3.11' \
    '-DPYTHON_LIBRARY=/usr/lib/x86_64-linux-gnu/libpython3.11.so'"


# Isaac Sim runtime
FROM nvcr.io/nvidia/isaac-sim:5.1.0 AS final
#hadolint ignore=DL3002
USER root

RUN echo "alias python=/isaac-sim/python.sh" >>${HOME}/.bashrc \
    && echo "alias python3=/isaac-sim/python.sh" >>${HOME}/.bashrc \
    && echo "alias pip='/isaac-sim/python.sh -m pip'" >>${HOME}/.bashrc \
    && echo "alias pip3='/isaac-sim/python.sh -m pip'" >>${HOME}/.bashrc

WORKDIR /
COPY requirements.txt requirements.txt
RUN apt-get update \
    && apt-get install linux-libc-dev build-essential -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && /isaac-sim/python.sh -m pip install -r requirements.txt \
    && /isaac-sim/python.sh -m pip install --no-cache-dir "pynput==1.8.*" lark em \
    && rm requirements.txt

COPY --from=builder /workspace/build_ws/install /opt/humanoid-mrl-msg-workspace/install
