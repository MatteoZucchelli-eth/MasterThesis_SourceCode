# =============================================================================
# isaac-render.def — Apptainer/Singularity definition for the Isaac Sim 5.1
# headless RGB render smoke test on the ETH Euler cluster.
#
# Wraps the official NVIDIA Isaac Sim 5.1 container and bakes in:
#   - the smoke-test script (so the .sif is self-contained — one file to rsync)
#   - Omniverse EULA / privacy acceptance (non-interactive batch runs)
#   - a %runscript that invokes the bundled python.sh on the smoke test
#
# Build (on a machine with rootful Docker + NGC access, from the repo root):
#   docker login nvcr.io                 # NGC API key; one-time
#   docker pull nvcr.io/nvidia/isaac-sim:5.1.0
#   apptainer build isaac-render.sif isaac-render.def
#   tar -czf isaac-render.tar.gz isaac-render.sif && rm isaac-render.sif
#
# (Verify the exact 5.1 tag on NGC — it may be e.g. 5.1.0 or 5.1.0-rc.X.)
# =============================================================================

Bootstrap: docker-daemon
From: nvcr.io/nvidia/isaac-sim:5.1.0

%files
    # Bake the smoke test in so the artifact is self-contained.
    # (submit_render_smoketest.sh can still bind-mount a newer copy over this
    #  path to iterate without rebuilding the multi-GB image.)
    euler_render_smoketest.py /workspace/euler_render_smoketest.py

%environment
    # Accept the Omniverse EULA non-interactively — required for batch/headless.
    export ACCEPT_EULA=Y
    export OMNI_KIT_ACCEPT_EULA=YES
    export PRIVACY_CONSENT=Y
    # Isaac Sim's container runs as root; allow it under Apptainer's user mapping.
    export OMNI_KIT_ALLOW_ROOT=1

%runscript
    # Forward args (e.g. --out /results/smoke.png) straight to the smoke test.
    exec /isaac-sim/python.sh /workspace/euler_render_smoketest.py "$@"

%labels
    Purpose IsaacSim-5.1-headless-RGB-render-smoketest
    Maintainer mzucchelli
